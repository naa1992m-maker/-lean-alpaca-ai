@app.post("/api/order")
def create_order(
    order: OrderRequest,
    x_api_key: Optional[str] = Header(default=None),
):
    authenticate(x_api_key)

    symbol = order.symbol.upper()

    if order.qty is None and order.notional is None:
        raise HTTPException(
            status_code=400,
            detail="Provide qty or notional."
        )

    if order.order_type.lower() == "market":
        if order.limit_price is not None:
            raise HTTPException(
                status_code=400,
                detail="limit_price is only valid for limit orders."
            )

    try:
        account_data = alpaca.get_account()
        current_positions = alpaca.get_positions()

        allowed, message = risk.validate_order(
            account=account_data,
            positions=current_positions,
            symbol=symbol,
            side=order.side,
            notional=order.notional,
            qty=order.qty,
            estimated_price=order.limit_price,
        )

        if not allowed:
            raise HTTPException(
                status_code=403,
                detail=message
            )

        result = alpaca.submit_order(
            symbol=symbol,
            qty=order.qty,
            notional=order.notional,
            side=order.side,
            order_type=order.order_type,
            time_in_force=order.time_in_force,
            limit_price=order.limit_price,
            stop_price=order.stop_price,
        )

        return {
            "success": True,
            "message": "Order submitted.",
            "order": result,
        }

    except HTTPException:
        raise

    except Exception as e:
        raise HTTPException(
            status_code=500,
            detail=str(e)
        )


